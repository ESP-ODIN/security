# Configuration reference. Export these variables before starting the API.
# This file and .env are not automatically loaded by the application.
# Port exposé sur la machine hôte par `make docker-dev` (le conteneur écoute toujours sur 8080 en interne).
PORT=8093
HTTP_ADDR=127.0.0.1:8080
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
AUTH_JWKS_URL=http://localhost:8080/.well-known/jwks.json
AUTH_ISSUER=http://localhost:8080
AUTH_AUDIENCE=odin-api
# UUID Auth des admins, séparés par des virgules. Vide : personne n'est admin.
ADMIN_USER_IDS=
# Note : ce fichier est un env-file Docker (pas du shell) : ne PAS mettre de guillemets,
# même si l'URL contient un "&" (docker --env-file lit la ligne telle quelle).
